# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it contains sensitive credentials.

# --- SQL Server Connection ---
DB_SERVER=YOUR_SERVER\SQLEXPRESS
DB_NAME=LOG_COLLECTOR_DB
ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# yes is for local/testing only; use a trusted certificate in production
DB_TRUST_SERVER_CERT=yes

# --- Dashboard Server ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# --- Optional: HTTP Basic Auth ---
# Before switching host to 0.0.0.0 for LAN access, set auth and TLS reverse proxy.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Excel Export ---
# Max rows in one Excel export; narrow date range for larger datasets
EXCEL_MAX_ROWS=250000
